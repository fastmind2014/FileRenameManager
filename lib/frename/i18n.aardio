	//设置当前语言；传入不支持的代码时保持原语言不变
	//返回是否设置成功
	setLang = function(code){
		if(type(code) != "string") return false;

		var ok = false;
		for(i=1;#..frename.i18n.LANGS;1){
			if(..frename.i18n.LANGS[i] == code) ok = true;
		}
		if(!ok) return false;

		..frename.i18n.current = code;
		return true;
	}

	//取当前语言代码
	getLang = function(){
		return ..frename.i18n.current;
	}

	//取文案
	//key   文案键，例如 "btn.execute"
	//...   可选，依次替换文案里的 {1} {2} …
	//
	//取不到时返回 key 本身，界面上会直接露出漏翻的键名，方便排查
	t = function(key,...){
		var args = {...};

		var tbl = ..frename.i18n.STRINGS[ ..frename.i18n.current ];
		if(type(tbl) != "table") tbl = ..frename.i18n.STRINGS["en"];
		if(type(tbl) != "table") return key;

		var s = tbl[key];
		if(type(s) != "string") return key;

		if(#args){
			for(i=1;#args;1){
				//占位符替换必须用 replaceLiteral（字面替换）：
				//
				//1. 不能用 string.replace —— 它的查找串按「模式串」解析，
				//   而 {1} 的花括号正是量词语法，会让替换异常、把文案改坏。
				//2. 也不能用 indexOf + left/right 手工拼接 —— indexOf 返回字节位置，
				//   而 left/right 默认按字符计数；含中文的文案（如「规则 {1} 条」）
				//   两者口径不一致，会切错位置、只替换掉一部分，残留的 "}" 漏到界面上。
				//
				//replaceLiteral 查找与替换都按字面值，没有上述两种问题。
				s = ..string.replaceLiteral(s, "{" ++ i ++ "}", tostring(args[i]));
			}
		}

		return s;
	}
}
