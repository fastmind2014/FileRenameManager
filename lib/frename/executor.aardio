// frename.executor —— 重命名执行器（纯逻辑，文件操作全部由注入函数模拟）
//
// 职责：按 renameplan 生成的两阶段计划逐步执行，
// 任一步失败就自动回滚已执行的步骤；也可以按 undo 日志主动撤销。
//
// 严格限制：本模块不直接调用任何文件系统 API。
// 所有文件操作都通过调用方注入的 moveFunc / existsFunc / deleteFunc 完成：
//   existsFunc(path)            该路径当前是否存在
//   moveFunc(from,to)           移动/改名，成功返回 true
//   deleteFunc(path)            删除，成功返回 true（rollback 不再调用它：撤销时绝不删除文件）
// 测试里可以全部用内存中的假实现；界面上也可以先接模拟实现再接真实实现。
// 本模块不创建、修改、移动、删除或重命名任何真实文件。
//
// 安全设计：如果调用方没有注入 moveFunc / deleteFunc，它们默认返回 false，
// 也就是「什么都不做、执行必然失败」，避免忘记注入时误操作真实文件系统。

import frename.filescan;
import frename.i18n;

namespace frename.executor{

	//补齐上下文中缺失的函数。
	//缺省的 existsFunc 用 io.exist 做只读判断；
	//缺省的 moveFunc / deleteFunc 一律返回 false —— 没有执行能力就不动手。
	normCtx = function(ctx){
		var c = {};
		if(type(ctx) == "table") c = ..table.assign({},ctx);

		if(type(c.existsFunc) != "function"){
			c.existsFunc = function(p){
				return ..io.exist(p) ? true : false;
			}
		}
		if(type(c.moveFunc) != "function"){
			c.moveFunc = function(from,to){
				return false;
			}
		}
		if(type(c.deleteFunc) != "function"){
			c.deleteFunc = function(p){
				return false;
			}
		}

		return c;
	}

	//按计划执行重命名（两阶段：先全部进临时名，再全部进最终名）
	//
	//plan    renameplan.build 的返回值
	//ctx   { existsFunc; moveFunc; deleteFunc }
	//
	//返回 executionResult：
	//   success        是否全部步骤都成功
	//   executed       成功执行的步骤数组，同时就是 undo 日志
	//   failedStep     失败的步骤与原因，没有失败为 null
	//   rolledBack     失败后是否执行了自动回滚
	//   rollbackOk     自动回滚是否完全成功
	//   rollbackFailed 自动回滚中失败的步骤
	//   message        人读的结果摘要
	//注意：不能用 execute 这个名字 —— 它是 aardio 的内置函数（execute("pause") 之类），
	//在命名空间里赋值会报 "Can't modify the constant : 'execute'"。
	executePlan = function(plan,ctx){
		var c = ..frename.executor.normCtx(ctx);

		var result = {
			success = false;
			executed = {};
			failedStep = null;
			rolledBack = false;
			rollbackOk = true;
			rollbackFailed = {};
			message = "";
		};

		if(type(plan) != "table" || type(plan.steps) != "table"){
			result.message = ..frename.i18n.t("exec.emptyPlan");
			return result;
		}

		for(i=1;#plan.steps;1){
			var s = plan.steps[i];
			if(type(s) != "table") continue;

			//前置检查：来源必须存在，目标必须没有被占用
			if(!c.existsFunc(s.from)){
				result.failedStep = { step=s; reason=..frename.i18n.t("exec.srcMissing", s.from) };
				break;
			}
			if(c.existsFunc(s.to)){
				result.failedStep = { step=s; reason=..frename.i18n.t("exec.dstOccupied", s.to) };
				break;
			}
			//第三个参数 true：上面刚查过「源存在、目标未被占用」，
			//让适配层不必再重复查一遍，批量执行时每步省 2 次磁盘查询
			if(!c.moveFunc(s.from,s.to,true)){
				result.failedStep = { step=s; reason=..frename.i18n.t("exec.moveFailed", s.from, s.to) };
				break;
			}

			..table.push(result.executed,s);
		}

		//全部走完：成功
		if(!result.failedStep){
			result.success = true;
			result.message = ..frename.i18n.t("exec.successMsg", #result.executed);
			return result;
		}

		//中途失败：自动回滚已执行的步骤，尽量回到执行前的状态
		result.message = ..frename.i18n.t("exec.failMsg",
			tostring(result.failedStep.step.phase), result.failedStep.reason);

		var rb = ..frename.executor.rollback(result.executed,c);

		result.rolledBack = true;
		result.rollbackOk = rb.ok;
		result.rollbackFailed = rb.failed;

		if(rb.ok){
			result.message = result.message ++ ..frename.i18n.t("exec.restored");
		}
		else {
			result.message = result.message ++ ..frename.i18n.t("exec.restorePartial", #rb.failed);
		}

		return result;
	}

	//按 undo 日志逆序撤销
	//
	//executionLog  executePlan 返回的 executed 数组（也可以是其中一部分）
	//ctx           与 executePlan 相同
	//
	//返回 { ok; doneCount; failed }
	//   ok        是否每一步都撤销成功
	//   doneCount 成功撤销的步数
	//   failed    撤销失败的步骤与原因
	//
	//逆序是为了让中间状态始终一致：后执行的先撤销。
	rollback = function(executionLog,ctx){
		var c = ..frename.executor.normCtx(ctx);

		var r = { ok=true; doneCount=0; failed={} };

		if(type(executionLog) != "table"){
			r.ok = false;
			return r;
		}

		for(i=#executionLog;i>=1;i--){
			var e = executionLog[i];
			if(type(e) != "table") continue;

			var fromExists = c.existsFunc(e.from);
			var toExists = c.existsFunc(e.to);

			//已撤销：e.from 已存在、e.to 已不存在，说明这条早已恢复
			//（例如自动回滚已把它改回原名，用户随后又手动 Undo 一次）。
			//必须直接跳过，绝不能删除 e.from——否则会把已恢复的原始文件误当“残留”删掉，造成数据丢失。
			if(fromExists && !toExists){
				r.doneCount = r.doneCount + 1;
				continue;
			}

			//其余情况一律交给 moveFunc(e.to -> e.from)：
			//   e.from 不在、e.to 在：正常撤销。
			//   e.from 不在、e.to 不在：moveFunc 因来源缺失而失败（沿用 undoMoveFail 原因）。
			//   e.from 在、e.to 也在：moveFunc 因目标已存在而失败，且不覆盖、不删除任何文件（安全失败）。
			//这里绝不为了继续撤销而 deleteFunc(e.from)——那会误删文件。
			if(!c.moveFunc(e.to,e.from)){
				..table.push(r.failed,{ step=e; reason=..frename.i18n.t("exec.undoMoveFail", e.to, e.from) });
				continue;
			}

			r.doneCount = r.doneCount + 1;
		}

		if(#r.failed) r.ok = false;
		return r;
	}

	//是否还有可撤销的步骤
	canUndo = function(executionLog){
		if(type(executionLog) != "table") return false;
		return (#executionLog > 0);
	}

	//把 undo 日志格式化成一行行文本
	undoLogText = function(executionLog){
		if(type(executionLog) != "table") return "";

		var s = "";
		for(i=1;#executionLog;1){
			var e = executionLog[i];
			if(type(e) != "table") continue;
			if(#s) s = s ++ '\r\n';
			s = s ++ "阶段" ++ tostring(e.phase) ++ "：" ++ tostring(e.from)
				++ "  →  " ++ tostring(e.to);
		}
		return s;
	}
}
