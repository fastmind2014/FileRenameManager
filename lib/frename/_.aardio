// frename —— 命名规则引擎（纯逻辑，与界面解耦）
//
// 职责：接收"文件列表 + 规则列表"，返回"每个文件的原始名 / 目标名 / 逐条规则结果 / 是否变化"。
// 本模块只计算名称字符串，不读取、创建、修改、移动或删除任何真实文件，也不接触界面。
//
// 行为依据（旧版 Wails/Go 项目，只读参考，未修改）：
//   backend/pkg/rename/engine.go        Engine.Preview / PreviewResult
//   backend/app.go                      App.PreviewRename（自定义目标优先级、排序后下标即序号）

import frename.rules;
import frename.nameutil;

namespace frename{

	//规则类型常量（取值与旧版 backend/pkg/rename/rules/prefix.go 的 RuleType 一致）
	TYPE_ADD_TEXT = "add_text";
	TYPE_REPLACE = "replace";
	TYPE_REGEX_REPLACE = "regex_replace";
	TYPE_CASE_CONVERT = "case_convert";
	TYPE_SEQUENCE = "sequence";
	TYPE_DATE_TIME = "date_time";

	//占位符：由规则写入，由引擎在预览阶段替换为真实值
	PLACEHOLDER_SEQUENCE = "{sequence}";
	PLACEHOLDER_DATETIME = "{datetime}";

	//批量预览
	//
	//files    文件名数组。每项可以是文件名字符串，也可以是表：
	//           name         文件名（必填）
	//           path         完整路径（可选，仅用于自定义目标的 changed 判定）
	//           modTime      修改时间（可选，Unix 秒 或 aardio time 对象；0 视为未提供）
	//           customTarget 自定义目标路径（可选，非空时优先级高于全部规则）
	//rules    规则数组。每项为表：type / enabled / params
	//          调用方应保证 files 已按需要的顺序排好；序列号的取值依赖这个顺序
	//nowTime  可选。指定"当前时间"，缺省取系统当前时间（测试时可用于固定时间）
	//
	//返回值：结果数组，每项为表
	//           originalName  原始文件名
	//           newName       计算出的目标文件名
	//           changed       是否发生变化
	//           error         错误描述（无错误为 null）
	//           useCustomRule 是否走了自定义目标分支
	//           steps         逐条规则的处理结果数组：
	//                         type / description / enabled / before / after / error
	preview = function(files,rules,nowTime){
		var results = {};

		if(type(files) != "table") return results;
		if(type(rules) != "table") rules = {};
		if(nowTime === null) nowTime = ..time();

		for(i=1;#files;1){
			var item = files[i];

			var originalName = "";
			var path;
			var customTarget;
			var modTime;

			if(type(item) == "string"){
				originalName = item;
			}
			elseif(type(item) == "table"){
				if(type(item.name) == "string") originalName = item.name;
				path = item.path;
				customTarget = item.customTarget;
				modTime = item.modTime;
			}

			var steps = {};

			//---------- 自定义目标分支（优先级高于全部规则）----------
			//对应 backend/app.go PreviewRename：CustomTarget 非空时直接取 filepath.Base，
			//并且不再应用任何规则
			if(type(customTarget) == "string" && #customTarget){
				var basePath = path;
				if(type(basePath) != "string" || !#basePath) basePath = originalName;

				..table.push(results,{
					originalName = originalName;
					newName = ..frename.nameutil.baseNameOf(customTarget);
					changed = (customTarget != basePath);
					error = null;
					useCustomRule = true;
					steps = steps;
				});
			}
			else {
				//---------- 规则引擎分支 ----------
				var current = originalName;
				var errMsg;

				//旧版 Go 数组下标从 0 开始，序列号直接用这个下标
				var index = i - 1;

				//时间取值，对应 engine.Preview：
				//   currentModTime 非零则用文件修改时间，否则用当前时间
				//注意：旧版并没有用 useFileTime 参数来决定是否取文件时间
				var t;
				if(type(modTime) == "number"){
					if(modTime != 0) t = ..time(modTime);	//Unix 秒
				}
				elseif(modTime !== null){
					if(..time.is(modTime)) t = modTime;		//已经是 time 对象
				}
				if(t === null) t = nowTime;

				for(k=1;#rules;1){
					var rule = rules[k];
					if(type(rule) != "table") rule = {};

					var ruleType = rule.type;
					if(type(ruleType) != "string") ruleType = "";

					if(rule.enabled){
						var next,err = ..frename.rules.apply(rule,current);
						var seqStr,dtStr;
						var seqPos,dtPos;

						if(next === null){
							//规则失败：保留已应用的结果，停止后续规则，并记录错误
							errMsg = "规则 " ++ ..frename.rules.description(rule) ++ " 应用失败: " ++ tostring(err);

							..table.push(steps,{
								type = ruleType;
								description = ..frename.rules.description(rule);
								enabled = true;
								before = current;
								after = current;
								error = errMsg;
							});

							break;
						}

						//占位符填充：旧版在每条规则应用完成后立刻替换
						//string.indexOf 会返回开始位置与结束位置两个值，这里只取第一个
						seqPos = ..string.indexOf(next,..frename.PLACEHOLDER_SEQUENCE);
						if(seqPos){
							if(ruleType == ..frename.TYPE_SEQUENCE){
								seqStr = ..frename.rules.formatSequence(rule,index);
							}
							else {
								//旧版兜底：非序列规则产生的占位符按 3 位补零、从 1 开始
								seqStr = ..frename.nameutil.padNumber(index+1,3);
							}

							next = ..string.replaceLiteral(next,..frename.PLACEHOLDER_SEQUENCE,seqStr);
						}

						dtPos = ..string.indexOf(next,..frename.PLACEHOLDER_DATETIME);
						if(dtPos){
							if(ruleType == ..frename.TYPE_DATE_TIME){
								dtStr = ..frename.rules.formatDateTime(rule,t);
							}
							else {
								//旧版兜底：非日期时间规则产生的占位符按 20060102 格式化
								dtStr = tostring(t,"%Y%m%d");
							}

							next = ..string.replaceLiteral(next,..frename.PLACEHOLDER_DATETIME,dtStr);
						}

						..table.push(steps,{
							type = ruleType;
							description = ..frename.rules.description(rule);
							enabled = true;
							before = current;
							after = next;
							error = null;
						});

						current = next;
					}
					else {
						//禁用规则：完全跳过，不改变名称
						..table.push(steps,{
							type = ruleType;
							description = ..frename.rules.description(rule);
							enabled = false;
							before = current;
							after = current;
							error = null;
						});
					}
				}

				..table.push(results,{
					originalName = originalName;
					newName = current;
					changed = (current != originalName);
					error = errMsg;
					useCustomRule = false;
					steps = steps;
				});
			}
		}

		return results;
	}

	//统计预览结果：总数 / 变化数 / 未变化数 / 错误数
	//字段与旧版 backend/pkg/models/models.go 的 Statistics 一致
	statistics = function(results){
		var st = { totalFiles = 0; changedFiles = 0; unchangedFiles = 0; errorFiles = 0 };
		if(type(results) != "table") return st;

		for(i=1;#results;1){
			st.totalFiles = st.totalFiles + 1;
			if(results[i].changed) st.changedFiles = st.changedFiles + 1;
			else st.unchangedFiles = st.unchangedFiles + 1;
			if(results[i].error) st.errorFiles = st.errorFiles + 1;
		}

		return st;
	}
}
