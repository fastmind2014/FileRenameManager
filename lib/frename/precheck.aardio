// frename.precheck —— 重命名预检（纯逻辑）
//
// 职责：在「不改动任何文件」的前提下，判断每个文件算出的目标路径能不能安全执行，
// 并说明具体原因。本模块不读取、创建、修改、移动、删除或重命名任何文件。
//
// 路径比较统一走 frename.filescan.pathKey：
// Windows 文件系统不区分大小写，且分隔符可能是 / 或 \，
// 因此不能拿未经处理的字符串直接比较。

import frename.filescan;
import frename.i18n;

namespace frename.precheck{

	//Windows 文件名不允许出现的字符（含路径分隔符，防止目标名被解释成路径）
	INVALID_CHARS = { '\\'; "/"; ":"; "*"; "?"; '"'; "<"; ">"; "|" };

	//Windows 保留设备名（不区分大小写，带不带扩展名都算）
	RESERVED_NAMES = { "CON";"PRN";"AUX";"NUL";
		"COM1";"COM2";"COM3";"COM4";"COM5";"COM6";"COM7";"COM8";"COM9";
		"LPT1";"LPT2";"LPT3";"LPT4";"LPT5";"LPT6";"LPT7";"LPT8";"LPT9" };

	//检查目标文件名是否合法；返回 null 表示合法，否则返回原因文本
	invalidNameReason = function(name){
		if(type(name) != "string" || !#name) return ..frename.i18n.t("check.emptyName");

		//不允许的字符
		for(i=1;#..frename.precheck.INVALID_CHARS;1){
			var c = ..frename.precheck.INVALID_CHARS[i];
			if(..string.indexOf(name,c)) return ..frename.i18n.t("check.invalidChar", c);
		}

		//结尾是空格或点时，Windows 会自动去掉，实际名字会与预期不一致
		var last = ..string.right(name,1);
		if(last == " ") return ..frename.i18n.t("check.trailingSpace");
		if(last == ".") return ..frename.i18n.t("check.trailingDot");

		//保留设备名：去掉扩展名后再比较
		var stem = name;
		var p = ..string.indexOf(stem,".");
		if(p) stem = ..string.left(stem,p-1);

		var up = ..string.upper(stem);
		for(i=1;#..frename.precheck.RESERVED_NAMES;1){
			if(up == ..frename.precheck.RESERVED_NAMES[i]) return ..frename.i18n.t("check.reservedName", up);
		}

		return null;
	}

	//预检
	//
	//items 每项为表：
	//   sourcePath  源文件完整路径
	//   targetPath  目标完整路径
	//   targetName  目标文件名
	//   changed     名称是否发生变化
	//   error       命名规则计算时的错误（无错误为 null / 假值）
	//
	//existsFn 可选：function(path) 返回该路径「当前是否存在」。
	//   默认用 io.exist；测试时可注入纯内存的假实现，避免依赖真实磁盘。
	//
	//返回原数组，每项附加：
	//   status      "error" / "warning" / "ok" / "unchanged"
	//   reasons     具体原因数组（可能为空）
	//   occupancy   目标占用分类："none" / "batch_source" / "outside" / "self_case"
	//   needRecheck 恒为 true：预检之后源文件仍可能被其它程序改动，执行前必须重新检查
	check = function(items,existsFn){
		if(type(items) != "table") return {};

		if(!existsFn){
			existsFn = function(p){
				return ..io.exist(p) ? true : false;
			}
		}

		//源文件路径键 -> 下标，用来区分「目标被本批次源文件占用」和「被批次之外占用」
		var sourceKeys = {};
		for(i=1;#items;1){
			var it = items[i];
			if(type(it) != "table") continue;
			var sk = ..frename.filescan.pathKey(it.sourcePath);
			if(#sk) sourceKeys[[sk]] = i;
		}

		//目标路径键出现次数：>1 说明多个文件算出了同一个目标
		//（pathKey 已统一大小写与分隔符，因此「仅大小写不同」也会落在同一个键上）
		var targetCount = {};
		for(i=1;#items;1){
			var it = items[i];
			if(type(it) != "table") continue;
			if(it.error) continue;			//规则已失败的项不参与目标冲突统计
			if(!it.changed) continue;		//未变化的项目标就是自己，不算冲突

			var tk = ..frename.filescan.pathKey(it.targetPath);
			if(!#tk) continue;
			targetCount[[tk]] = (targetCount[[tk]] : 0) + 1;
		}

		for(i=1;#items;1){
			var it = items[i];
			if(type(it) != "table") continue;

			var reasons = {};
			it.reasons = reasons;
			it.occupancy = "none";
			it.needRecheck = true;

			//1. 命名规则本身计算失败
			if(it.error){
				it.status = "error";
				..table.push(reasons,..frename.i18n.t("check.ruleFailed", tostring(it.error)));
				continue;
			}

			//2. 目标名为空或不合法
			var badName = ..frename.precheck.invalidNameReason(it.targetName);
			if(badName){
				it.status = "error";
				..table.push(reasons,badName);
				continue;
			}

			//3. 未变化：不需要执行，也不算风险
			if(!it.changed){
				it.status = "unchanged";
				continue;
			}

			var tk = ..frename.filescan.pathKey(it.targetPath);

			//4. 多个源文件算出同一个目标（含「仅大小写不同」）
			if((targetCount[[tk]] : 0) > 1){
				var onlyCase = false;
				for(j=1;#items;1){
					var o = items[j];
					if(type(o) != "table" || j == i) continue;
					if(o.error || !o.changed) continue;
					if(..frename.filescan.pathKey(o.targetPath) != tk) continue;
					//比较键相同但原始字符串不同 —— 只有大小写差异
					if(o.targetPath != it.targetPath) onlyCase = true;
				}

				it.status = "error";
				if(onlyCase) ..table.push(reasons,..frename.i18n.t("check.onlyCase"));
				else ..table.push(reasons,..frename.i18n.t("check.dupTarget"));
				continue;
			}

			//5. 目标当前是否已存在
			if(existsFn(it.targetPath)){
				var srcIdx = sourceKeys[[tk]];

				if(srcIdx == i){
					//目标就是自己：只是大小写变化
					it.occupancy = "self_case";
					it.status = "warning";
					..table.push(reasons,..frename.i18n.t("check.selfCase"));
				}
				elseif(srcIdx){
					//被本批次其它待处理文件占用：A→B、B→C 这类链式情形。
					//它不是必然冲突，但能否成功取决于执行顺序，所以标记为风险而不是错误。
					it.occupancy = "batch_source";
					it.status = "warning";
					..table.push(reasons,..frename.i18n.t("check.chainOccupied"));
				}
				else {
					//被本批次之外的文件占用：真实冲突
					it.occupancy = "outside";
					it.status = "error";
					..table.push(reasons,..frename.i18n.t("check.outsideOccupied"));
				}
				continue;
			}

			it.status = "ok";
		}

		return items;
	}

	//统计预检结果
	//   total     扫描到的文件总数
	//   unchanged 未变化（不需要执行）
	//   ok        可安全执行
	//   warning   有风险（需要人工确认执行顺序等）
	//   error     不能执行
	//   risky     warning + error，即「存在风险」的总数
	statistics = function(items){
		var st = { total=0; unchanged=0; ok=0; warning=0; error=0; risky=0 };
		if(type(items) != "table") return st;

		for(i=1;#items;1){
			var it = items[i];
			if(type(it) != "table") continue;

			st.total = st.total + 1;
			if(it.status == "unchanged") st.unchanged = st.unchanged + 1;
			elseif(it.status == "ok") st.ok = st.ok + 1;
			elseif(it.status == "warning") st.warning = st.warning + 1;
			else st.error = st.error + 1;
		}

		st.risky = st.warning + st.error;
		return st;
	}

	//把原因数组拼成一行文本，便于列表显示
	reasonText = function(it){
		if(type(it) != "table") return "";
		if(type(it.reasons) != "table" || !#it.reasons) return "";

		var s = "";
		for(i=1;#it.reasons;1){
			if(#s) s = s ++ "；";
			s = s ++ tostring(it.reasons[i]);
		}
		return s;
	}
}
