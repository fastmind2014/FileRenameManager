//---------- 接管自动布局 ----------
//
//aardio 内部默认把「所有」控件都登记进窗体私有表 _ctrlAutoResize，
//WM_SIZE 时会对它们做按比例缩放（没有 anchors 也照缩：l = 设计时left * scaleX）。
//这跟下面的 applyLayout 手动排布会互相打架。
//
//这里把登记表清空，让内部重排彻底跳过本窗体的全部控件，
//窗口缩放完全由 applyLayout 决定。
//（winform.add 会为每个控件写 _ctrlHwnd[hwnd] = 控件对象，据此遍历即可）

for(hwnd,ctrl in winform._ctrlHwnd){
	winform._ctrlAutoResize[hwnd] = null;
}

//---------- 布局常量 ----------
//本窗体不使用设计器的 anchors，改为在 applyLayout 里用 setPos 统一排布，
//这样才能做到「规则列表填满剩余高度、参数区和说明区贴着底部、预览区随宽度伸缩」。

var M = 12;               //窗体四周外边距
var GAP = 12;             //左右两列之间的间距
var LEFT_W = 440;         //左列固定宽度
var LIST_TOP = 68;        //规则列表顶部（标题与下拉框之下）
var BTN_H = 30;           //按钮行高度
var ROW_H = 26;           //参数行高度
var ROW_STEP = 30;        //参数行行距
var LBL_PARAM_W = 150;    //参数行标签宽度
var GAP_PARAM = 4;        //参数行标签与输入的间距
var LBL_PARAMS_H = 26;    //「规则参数：」标题高度
var HINT_H = 92;          //左下说明区高度（文字会折行，要留够）
var STATUS_H = 28;        //状态栏高度
var MIN_LIST_H = 90;      //规则列表最小高度
var MIN_RIGHT_W = 360;    //右侧预览区最小宽度

//客户区最小尺寸，防止窗口缩得过小把布局压坏
var MIN_CLIENT_W = 860;
var MIN_CLIENT_H = 560;

//---------- 列表列定义 ----------

//四列宽度固定，总和 = LEFT_W(440)，默认打开即可完整看到「状态」列。
//（之前「状态」列用 -1 走 fillParent 自适应，初始绘制/DPI/重排时容易被挤出可视区。）
winform.lvRules.columns = {
	{T("col.rules.no"),34,2/*_LVCFMT_CENTER*/};
	{T("col.rules.type"),90,0/*_LVCFMT_LEFT*/};
	{T("col.rules.desc"),236,0/*_LVCFMT_LEFT*/};
	{T("col.rules.status"),80,2/*_LVCFMT_CENTER*/}
};

//真实文件预览：完整路径放在最后两列，列宽固定，
//窗口不够宽时可横向滚动查看，也可以用鼠标双击某一行在状态栏看完整路径。
winform.lvPreview.columns = {
	{T("col.prev.orig"),110,0/*_LVCFMT_LEFT*/};
	{T("col.prev.target"),110,0/*_LVCFMT_LEFT*/};
	{T("col.prev.status"),60,2/*_LVCFMT_CENTER*/};
	{T("col.prev.note"),170,0/*_LVCFMT_LEFT*/};
	{T("col.prev.srcPath"),240,0/*_LVCFMT_LEFT*/};
	{T("col.prev.dstPath"),240,0/*_LVCFMT_LEFT*/}
};

//---------- 常量与静态数据 ----------

//六类规则：textKey 存 i18n 键（显示时再由 T() 取值），value 是规则 type 取值。
//存键而不是存文本，是为了切换语言后不必重建这两张表，
//下拉框与规则列表「说明」列都能跟着当前语言变。
var RULE_TYPES = {
	{ textKey="rule.add_text"; value=frename.TYPE_ADD_TEXT };
	{ textKey="rule.replace"; value=frename.TYPE_REPLACE };
	{ textKey="rule.regex_replace"; value=frename.TYPE_REGEX_REPLACE };
	{ textKey="rule.case_convert"; value=frename.TYPE_CASE_CONVERT };
	{ textKey="rule.sequence"; value=frename.TYPE_SEQUENCE };
	{ textKey="rule.date_time"; value=frename.TYPE_DATE_TIME }
};

//规则 type -> 显示文案的 i18n 键
var RULE_TYPE_TEXTS = {
	add_text = "rule.add_text";
	replace = "rule.replace";
	regex_replace = "rule.regex_replace";
	case_convert = "rule.case_convert";
	sequence = "rule.sequence";
	date_time = "rule.date_time"
};

//每种规则的默认参数（对应旧版 frontend/src/stores/rule.ts 的 getDefaultParams）
var defaultParams = function(t){
	if(t == frename.TYPE_ADD_TEXT) return { text="IMG_"; addPosition="prefix"; customPosition=0 };
	if(t == frename.TYPE_REPLACE) return { oldText=""; newText=""; caseSensitive=true; replaceScope="all"; scopeParam1=0; scopeParam2="" };
	if(t == frename.TYPE_REGEX_REPLACE) return { pattern=""; replacement=""; caseSensitive=true };
	if(t == frename.TYPE_CASE_CONVERT) return { caseType="upper" };
	if(t == frename.TYPE_SEQUENCE) return { start=1; step=1; digits=3; position="end" };
	if(t == frename.TYPE_DATE_TIME) return { format="20060102"; position="end"; useFileTime=false };
	return {};
}

//每种规则的参数面板定义
//kind = "edit" 文本输入 / "combo" 下拉选择 / "bool" 是-否选择
//最多 6 行（文本替换的参数最多）
//label 不要写太长，参数行标签宽度只有 LBL_PARAM_W，超出会被控件自动折行
//labelKey / textKeys 存 i18n 键，显示时再由 T() 取值 —— 切换语言后能立即生效；
//key / values / patterns / showIf.value 是内部取值，必须保持原样，不能翻译
var SCHEMA = {
	add_text = {
		{ key="text"; labelKey="sch.add_text.text"; kind="edit" };
		{ key="addPosition"; labelKey="sch.add_text.position"; kind="combo"; textKeys={"sch.add_text.pos.prefix";"sch.add_text.pos.suffix";"sch.add_text.pos.custom"}; values={"prefix";"suffix";"custom"} };
		//showIf：只有「添加位置」选中 custom 时才显示这一行
		{ key="customPosition"; labelKey="sch.add_text.customPos"; kind="edit"; showIf={key="addPosition";value="custom"} }
	};
	//「替换范围」是主控项，放在第一行；其余参数按所选范围用 showIf 决定显不显示：
	//   只有选中「查找文本」才需要 oldText 与 caseSensitive（按查找文本匹配替换）；
	//   其余范围是按位置把目标区间改写成 newText，不需要查找文本，
	//   只在该范围确实用到的「字符数 / 位置 / 字符」才显示对应的输入框。
	//「替换为」放在最后：不管选哪个范围它都要用，放最后一行位置才稳定，
	//   不会随着上面几行的隐藏而上移。
	replace = {
		{ key="replaceScope"; labelKey="sch.replace.scope"; kind="combo";
			textKeys={"sch.replace.scope.all";"sch.replace.scope.first_n";"sch.replace.scope.last_n";"sch.replace.scope.after_pos";"sch.replace.scope.after_char";"sch.replace.scope.before_char";"sch.replace.scope.after_char_n";"sch.replace.scope.before_char_n"};
			values={"all";"first_n";"last_n";"after_pos";"after_char";"before_char";"after_char_n";"before_char_n"} };
		{ key="oldText"; labelKey="sch.replace.oldText"; kind="edit"; showIf={key="replaceScope";value="all"} };
		{ key="caseSensitive"; labelKey="sch.replace.caseSensitive"; kind="bool"; showIf={key="replaceScope";value="all"} };
		//需要「字符数 N」的范围
		{ key="scopeParam1"; labelKey="sch.replace.scopeParam1"; kind="edit"; showIf={key="replaceScope";values={"first_n";"last_n";"after_pos";"after_char_n";"before_char_n"}} };
		//需要「位置 / 字符」的范围
		{ key="scopeParam2"; labelKey="sch.replace.scopeParam2"; kind="edit"; showIf={key="replaceScope";values={"after_pos";"after_char";"before_char";"after_char_n";"before_char_n"}} };
		//始终显示在最后一行
		{ key="newText"; labelKey="sch.replace.newText"; kind="edit" }
	};
	//preset 行不是真正的规则参数，只是把常用正则填进 pattern 输入框的快捷方式：
	//选中某一项后写入 target 指定的参数（第 1 项「自定义」不写入，保留手填的正则）。
	//注意：aardio 双引号内是原样字符串，反斜杠按字面处理，所以正则可以直接写。
	regex_replace = {
		{ key="__preset"; labelKey="sch.regex.preset"; kind="preset"; target="pattern";
			textKeys={"sch.regex.preset.custom";"sch.regex.preset.digits";"sch.regex.preset.nondigits";"sch.regex.preset.letters";"sch.regex.preset.chinese";"sch.regex.preset.space";"sch.regex.preset.date8";"sch.regex.preset.dateDash";"sch.regex.preset.inParen";"sch.regex.preset.inBracket";"sch.regex.preset.trailDigits"};
			patterns={"";"\d+";"\D+";"[a-zA-Z]+";"[\x{4e00}-\x{9fa5}]+";"\s+";"\d{8}";"\d{4}-\d{2}-\d{2}";"\([^)]*\)";"\[[^\]]*\]";"\d+$"} };
		{ key="pattern"; labelKey="sch.regex.pattern"; kind="edit" };
		{ key="replacement"; labelKey="sch.regex.replacement"; kind="edit" };
		{ key="caseSensitive"; labelKey="sch.regex.caseSensitive"; kind="bool" }
	};
	case_convert = {
		{ key="caseType"; labelKey="sch.case.type"; kind="combo";
			textKeys={"sch.case.upper";"sch.case.lower";"sch.case.first";"sch.case.title"};
			values={"upper";"lower";"first";"title"} }
	};
	sequence = {
		{ key="start"; labelKey="sch.seq.start"; kind="edit" };
		{ key="step"; labelKey="sch.seq.step"; kind="edit" };
		{ key="digits"; labelKey="sch.seq.digits"; kind="edit" };
		{ key="position"; labelKey="sch.seq.position"; kind="combo"; textKeys={"sch.seq.pos.end";"sch.seq.pos.start"}; values={"end";"start"} }
	};
	date_time = {
		{ key="format"; labelKey="sch.date.format"; kind="combo";
			texts={"20060102";"2006-01-02";"200601021504"};
			values={"20060102";"2006-01-02";"200601021504"} };
		{ key="position"; labelKey="sch.date.position"; kind="combo"; textKeys={"sch.date.pos.end";"sch.date.pos.start"}; values={"end";"start"} };
		{ key="useFileTime"; labelKey="sch.date.useFileTime"; kind="bool" }
	}
};

//模拟文件名：只存在于内存中，不代表磁盘上的真实文件
var MOCK_FILES = { "photo.jpg"; "holiday.png"; "report.txt"; "archive.tar.gz"; ".gitignore" };

//固定测试时间（Unix 秒）：2026-01-02 15:04:05 本地时区
//模拟数据不提供修改时间，因此日期时间规则一律使用这个时间，保证预览可复现
var TEST_TS = 1767337445;
var TEST_TIME = time(TEST_TS);

//---------- 运行时状态 ----------

var rules = {};     //当前规则数组，每项 { type; enabled; params }
var selRule = 0;    //当前选中的规则下标（1 开始，0 表示未选中）
var busy = false;   //正在用代码写控件值，避免把程序赋值当成用户输入再回写一次

//真实文件列表（只读取元数据，绝不修改磁盘上的文件）
//每项 { path; dir; name; size; modTime }
var realFiles = {};
//已加载文件的路径比较键集合，多次加载时用来去重
var fileKeys = {};
//最近一次预览/预检的明细，行号与 lvPreview 一一对应（双击看完整路径时用）
var lastPreviewRows = {};

//---------- 控件分组 ----------

var PARAM_ROWS = 6;

var lblParams_ = { winform.lblP1; winform.lblP2; winform.lblP3; winform.lblP4; winform.lblP5; winform.lblP6 };
var editParams = { winform.txtP1; winform.txtP2; winform.txtP3; winform.txtP4; winform.txtP5; winform.txtP6 };
var comboParams = { winform.cmbP1; winform.cmbP2; winform.cmbP3; winform.cmbP4; winform.cmbP5; winform.cmbP6 };

//---------- 小工具 ----------

var setStatus = function(text){
	winform.lblStatus.text = text;
}

var typeText = function(t){
	if(type(t) != "string") return "";
	var k = RULE_TYPE_TEXTS[t];
	if(type(k) == "string") return T(k);
	return t;
}

var countEnabled = function(){
	var n = 0;
	for(i=1;#rules;1){
		if(rules[i].enabled) n = n + 1;
	}
	return n;
}

var schemaOf = function(rule){
	if(type(rule) != "table") return {};
	var t = rule.type;
	if(type(t) != "string") return {};
	var s = SCHEMA[t];
	if(type(s) != "table") return {};
	return s;
}

//规则的参数表；缺了就补一个空的，避免面板读写时报错
var paramsOf = function(rule){
	if(type(rule) != "table") return {};
	if(type(rule.params) != "table") rule.params = {};
	return rule.params;
}

//---------- 自适应布局 ----------

var lastStatusColW = 0;

//把「状态」列（第 4 列）设成填满控件剩余的宽度。
//setColumnWidth 传的是实际像素（不像 columns 那样再乘 dpiScaleX），
//这里按控件当前客户区宽减掉前 3 列的实际宽度，保证「状态」列永远完整可见，
//不会被 DPI 缩放或垂直滚动条挤到可视区之外。
var fitStatusColumn = function(){
	var rc = winform.lvRules.clientRect;
	if(!rc) return;

	var dpiX = winform.lvRules.dpiScaleX : 1;
	var used = 0;

	for(i=1;3;1){
		var col = winform.lvRules.getColumn({mask=2/*_LVCF_WIDTH*/}, i);
		if(col) used = used + (col.cx : 0);
	}

	var w = (rc.right - rc.left) - used;
	if(w < 40 * dpiX) w = 40 * dpiX;

	if(w != lastStatusColW){
		lastStatusColW = w;
		winform.lvRules.setColumnWidth(w,4);
	}
}

//按客户区尺寸重排所有控件
//cx,cy 省略时用 winform.getClientRect() 现取客户区尺寸。
//注意不能用 winform.width——顶层窗体的 width 是含边框标题栏的窗口宽度，
//只有 getClientRect() 才是客户区，两者差约 16 x 39 像素。
//
//重要：下面的布局常量都是「设计像素」，而 setPos 用的是「实际像素」（不会自动做 DPI 缩放）；
//listview 的列宽却是在设计值上被乘过 dpiScaleX 的（见 listview 的 insertColumn 源码）。
//两边不同步的话，高 DPI 下列宽总和会超过控件可见宽度，最后一列「状态」被挤出可视区。
//所以这里按同一个 dpiScale 把常量换算成实际像素再排布。
var applyLayout = function(cx,cy){
	if(!cx || !cy){
		var rc = winform.getClientRect();
		cx,cy = rc.width(),rc.height();
	}
	//最小化时客户区为 0，直接跳过，避免把布局算成一堆负数
	if(!cx || !cy) return;

	//DPI 缩放比例；取不到就按 1 处理
	//（与列宽缩放用的是同一个属性，保证控件宽度和列宽同步放大）
	var dpiX = winform.lvRules.dpiScaleX : 1;
	var dpiY = winform.lvRules.dpiScaleY : 1;

	//把设计尺寸换算成实际像素
	var mX = M * dpiX;                  var mY = M * dpiY;
	var leftW = LEFT_W * dpiX;
	var gapX = GAP * dpiX;
	var listTop = LIST_TOP * dpiY;
	var btnH = BTN_H * dpiY;
	var rowH = ROW_H * dpiY;
	var rowStep = ROW_STEP * dpiY;
	var lblParamW = LBL_PARAM_W * dpiX;
	var gapParam = GAP_PARAM * dpiX;
	var lblParamsH = LBL_PARAMS_H * dpiY;
	var hintH = HINT_H * dpiY;
	var statusH = STATUS_H * dpiY;
	var minListH = MIN_LIST_H * dpiY;
	var minRightW = MIN_RIGHT_W * dpiX;
	var g8y = 8 * dpiY;                //通用垂直间距

	//水平：左列固定宽，右列吃掉剩余宽度
	var rightX = mX + leftW + gapX;
	var rightW = cx - rightX - mX;
	if(rightW < minRightW) rightW = minRightW;

	//垂直：先把贴底的几块固定下来，再由下往上推算
	var statusTop = cy - mY - statusH;
	var hintTop = statusTop - g8y - hintH;
	var paramsBottom = hintTop - g8y;

	var paramsBlockH = PARAM_ROWS * rowH + (PARAM_ROWS - 1) * (rowStep - rowH);
	var paramsTop = paramsBottom - paramsBlockH;
	var lblParamsTop = paramsTop - lblParamsH;
	var btnTop = lblParamsTop - g8y - btnH;

	//规则列表吃掉中间剩下的高度
	var listH = btnTop - g8y - listTop;
	if(listH < minListH) listH = minListH;

	//左列
	winform.lvRules.setPos(mX,listTop,leftW,listH);

	//控件尺寸定下来以后，让「状态」列填满剩余宽度（扣掉滚动条等占用的部分）
	fitStatusColumn();

	winform.btnUp.setPos(mX,btnTop,88 * dpiX,btnH);
	winform.btnDown.setPos(mX + 96 * dpiX,btnTop,88 * dpiX,btnH);
	winform.btnDelete.setPos(mX + 192 * dpiX,btnTop,88 * dpiX,btnH);
	winform.chkEnabled.setPos(mX + 288 * dpiX,btnTop + 3 * dpiY,leftW - 288 * dpiX,24 * dpiY);

	winform.lblParams.setPos(mX,lblParamsTop,leftW,lblParamsH);

	for(i=1;PARAM_ROWS;1){
		var top = paramsTop + (i - 1) * rowStep;
		lblParams_[i].setPos(mX,top + 5 * dpiY,lblParamW,20 * dpiY);
		editParams[i].setPos(mX + lblParamW + gapParam,top,leftW - lblParamW - gapParam,rowH);
		comboParams[i].setPos(mX + lblParamW + gapParam,top,leftW - lblParamW - gapParam,rowH);
	}

	winform.lblHint.setPos(mX,hintTop,leftW,hintH);

	//右列：标题 + 文件操作按钮 + 预览列表
	winform.lblPreview.setPos(rightX,mY,rightW,20 * dpiY);

	var fileBtnY = mY + 24 * dpiY;
	var fileBtnH = 26 * dpiY;
	var fileBtnW = (rightW - 16 * dpiX) / 3;
	if(fileBtnW < 76 * dpiX) fileBtnW = 76 * dpiX;

	winform.btnLoadFiles.setPos(rightX,fileBtnY,fileBtnW,fileBtnH);
	winform.btnLoadDir.setPos(rightX + fileBtnW + 8 * dpiX,fileBtnY,fileBtnW,fileBtnH);
	winform.btnClearFiles.setPos(rightX + (fileBtnW + 8 * dpiX) * 2,fileBtnY,fileBtnW,fileBtnH);

	//第二行：执行 / 撤销。这两个按钮会真的改动磁盘，单独一行避免误点
	var execBtnY = fileBtnY + fileBtnH + 6 * dpiY;
	var execBtnW = (rightW - 8 * dpiX) / 2;
	if(execBtnW < 90 * dpiX) execBtnW = 90 * dpiX;

	winform.btnExecute.setPos(rightX,execBtnY,execBtnW,fileBtnH);
	winform.btnUndo.setPos(rightX + execBtnW + 8 * dpiX,execBtnY,execBtnW,fileBtnH);

	var previewTop = execBtnY + fileBtnH + g8y;
	winform.lvPreview.setPos(rightX,previewTop,rightW,statusTop - g8y - previewTop);

	//底部：状态栏 + 右侧语言切换
	var langW = 92 * dpiX;
	winform.lblStatus.setPos(mX,statusTop,cx - mX * 2 - langW - 8 * dpiX,statusH);
	winform.cmbLang.setPos(cx - mX - langW,statusTop,langW,statusH);
}

//---------- 规则列表 ----------

//清空所有行的选中与焦点状态
//必须做这一步：selIndex 只设置目标行，不会自动取消其他行的选中
var clearSelection = function(){
	winform.lvRules.setItemState(0,0,3/*_LVIS_FOCUSED|_LVIS_SELECTED*/);
}

//整表重建：仅在规则增删/换序时调用
var rebuildRuleList = function(){
	busy = true;
	winform.lvRules.clear();

	for(i=1;#rules;1){
		var r = rules[i];
		winform.lvRules.addItem({
			text = { tostring(i); typeText(r.type); frename.rules.description(r); r.enabled ? T("ruleState.enabled") : T("ruleState.disabled") };
		});
	}

	if(selRule > #rules) selRule = #rules;

	//先清空再设置，否则旧行的选中状态会残留，界面上出现两行高亮
	clearSelection();
	if(selRule > 0){
		winform.lvRules.selIndex = selRule;
		winform.lvRules.ensureVisible(selRule);
	}

	busy = false;
}

//只更新单行文字：改参数 / 改启用状态时用，避免打断输入焦点
var updateRuleRow = function(i){
	var r = rules[i];
	if(type(r) != "table") return;
	winform.lvRules.setItemText({ tostring(i); typeText(r.type); frename.rules.description(r); r.enabled ? T("ruleState.enabled") : T("ruleState.disabled") }, i);
}

//---------- 参数面板 ----------

//按当前参数值算出「实际要显示的参数定义」列表，已按顺序排好，不满足显示条件的不在里面。
//
//showParams 与 collectParams 必须共用这份列表：界面上可见的参数是紧凑排列的
//（隐藏的行不占位，后面的参数会往上移），两边用同一个顺序才能保证
//「第 i 行控件」对应「第 i 个可见定义」，读写不会错位。
var visibleSchema = function(rule){
	var schema = schemaOf(rule);
	var params = paramsOf(rule);
	var out = {};

	for(i=1;PARAM_ROWS;1){
		var def = schema[i];
		if(type(def) != "table") continue;

		//条件显示：showIf.value 是单个允许值；showIf.values 是允许值的数组（命中任意一个即显示）
		if(type(def.showIf) == "table"){
			var cur = tostring(params[def.showIf.key]);
			var ok;

			if(type(def.showIf.values) == "table"){
				ok = false;
				for(k=1;#def.showIf.values;1){
					if(def.showIf.values[k] == cur) ok = true;
				}
			}
			else {
				ok = (cur == def.showIf.value);
			}

			if(!ok) continue;
		}

		table.push(out,def);
	}

	return out;
}

//取某个参数定义在当前语言下的下拉选项文本。
//优先用 i18n 键（textKeys）；没有键就直接用字面数组（例如日期格式这类数据）。
var textsOf = function(def){
	var out = {};
	if(type(def.textKeys) == "table"){
		for(i=1;#def.textKeys;1){
			..table.push(out, T(def.textKeys[i]));
		}
		return out;
	}
	if(type(def.texts) == "table") return def.texts;
	return out;
}

//把当前选中规则的参数填进面板
var showParams = function(){
	var rule = rules[selRule];
	var schema = visibleSchema(rule);

	busy = true;

	if(type(rule) == "table"){
		winform.chkEnabled.checked = rule.enabled ? true : false;
	}
	else {
		winform.chkEnabled.checked = false;
	}

	var params = paramsOf(rule);

	for(i=1;PARAM_ROWS;1){
		var def = schema[i];

		if(type(def) == "table"){
			lblParams_[i].text = T(def.labelKey);
			lblParams_[i].visible = true;

			if(def.kind == "edit"){
				editParams[i].visible = true;
				comboParams[i].visible = false;
				editParams[i].text = tostring(params[def.key]);
			}
			elseif(def.kind == "bool"){
				editParams[i].visible = false;
				comboParams[i].visible = true;
				comboParams[i].items = { T("bool.no"); T("bool.yes") };
				comboParams[i].selIndex = params[def.key] ? 2 : 1;
			}
			elseif(def.kind == "preset"){
				editParams[i].visible = false;
				comboParams[i].visible = true;
				comboParams[i].items = textsOf(def);

				//当前正则命中哪个常用项就选中它，都没命中则显示第 1 项「自定义」
				var idx = 1;
				var cur = tostring(params[def.target]);
				for(k=1;#def.patterns;1){
					if(def.patterns[k] == cur) idx = k;
				}
				comboParams[i].selIndex = idx;
			}
			else {
				editParams[i].visible = false;
				comboParams[i].visible = true;
				comboParams[i].items = textsOf(def);

				var idx = 1;
				for(k=1;#def.values;1){
					if(def.values[k] == params[def.key]) idx = k;
				}
				comboParams[i].selIndex = idx;
			}
		}
		else {
			lblParams_[i].visible = false;
			editParams[i].visible = false;
			comboParams[i].visible = false;
		}
	}

	busy = false;
}

//把面板上的值写回当前选中规则
//说明：所有 edit 的值都按字符串存回。引擎读取参数时用的是
//frename.rules.numParam / strParam，会把字符串再转成需要的类型，行为不变。
var collectParams = function(){
	var rule = rules[selRule];
	if(type(rule) != "table") return;

	//与 showParams 用同一份可见定义列表，保证「第 i 行控件」对应「第 i 个可见参数」
	var schema = visibleSchema(rule);
	var params = paramsOf(rule);

	for(i=1;PARAM_ROWS;1){
		var def = schema[i];
		if(type(def) != "table") continue;

		if(def.kind == "edit"){
			params[def.key] = editParams[i].text;
		}
		elseif(def.kind == "bool"){
			var si = comboParams[i].selIndex;
			params[def.key] = (si == 2);
		}
		elseif(def.kind == "preset"){
			//常用正则不是真正的规则参数，这里特意不写回：
			//它的写入由 applyPreset 在「下拉选中」时单独做一次。
			//如果在这里写，那么每次收集参数都会用下拉的当前选项
			//覆盖掉用户手填进输入框的正则。
		}
		else {
			var ci = comboParams[i].selIndex;
			if(!ci) ci = 1;
			params[def.key] = def.values[ci];
		}
	}
}

//---------- 选中同步 ----------
//这两个函数必须定义在 showParams 之后：
//aardio 的局部变量从声明点起才可见，函数体里引用「后面才声明的 var 名字」
//会被当成全局变量，导致调用时取到 null。

//从控件实时读出「当前操作的是哪一行」
var currentRow = function(){
	var idx = winform.lvRules.selIndex;   //最后一次用鼠标点选的项（焦点项）
	if(idx) return idx;

	var sel = winform.lvRules.selected;
	if(type(sel) == "table" && #sel > 0) return sel[1];

	return 0;
}

//把界面选中状态同步到 selRule，并刷新参数面板
//做成幂等的：无论被调用多少次、由哪个通知触发，结果都只取决于控件的真实状态
var syncSelectionFromList = function(){
	if(busy) return;

	var idx = currentRow();
	if(idx == selRule) return;

	selRule = idx;
	showParams();
}

//---------- 预览 ----------

//构造传给引擎的文件数组。
//加载了真实文件就用真实文件（带 path 与 modTime，modTime 供日期时间规则使用），
//否则退回内存模拟数据。第二个返回值表示这次是不是真实文件。
var buildPreviewFiles = function(){
	if(#realFiles){
		var files = {};
		for(i=1;#realFiles;1){
			var f = realFiles[i];
			..table.push(files,{
				name = f.name;
				path = f.path;
				modTime = f.modTime;
			});
		}
		return files,true;
	}

	return MOCK_FILES,false;
}

//由预览结果构造「预检 / 校验 / 执行」共用的 items。
//真实文件时带完整路径；模拟数据只有文件名，没有真实路径。
var buildItems = function(res,isReal){
	var items = {};

	for(i=1;#res;1){
		var r = res[i];

		var sourcePath;
		var dir;
		if(isReal){
			var f = realFiles[i];
			sourcePath = f.path;
			dir = f.dir;
		}
		else {
			sourcePath = r.originalName;	//模拟数据没有真实路径
			dir = "";
		}

		var targetPath = #dir ? ..io.joinpath(dir,r.newName) : r.newName;

		..table.push(items,{
			sourcePath = sourcePath;
			targetPath = targetPath;
			targetName = r.newName;
			changed = r.changed;
			error = r.error;
			originalName = r.originalName;
			newName = r.newName;
		});
	}

	return items;
}

//---------- 预览刷新防抖 ----------
//文本框每敲一个字符都会触发 onChange，若每次都立刻刷新，
//每敲一下就要重算整份预览（真实文件还要再跑一遍磁盘预检），输入会明显卡顿。
//这里在停止输入一小段时间后才刷新，连续输入期间只保留最后一次。
var PREVIEW_DELAY = 300;	//停止输入后延迟多久刷新（毫秒）
var previewTimer = null;	//尚未触发的延迟刷新定时器
var previewSeq = 0;			//刷新序号，用来让已经过期的延迟刷新自动作废

var refreshPreview = function(){
	//立即刷新会让「还没触发的延迟刷新」自动作废，避免重复刷新
	previewSeq = previewSeq + 1;

	var res;
	var errText;
	var files,isReal = buildPreviewFiles();

	//注意：aardio 的 try catch 是立即执行的匿名函数体，
	//里面的 return 只会跳出 try catch 自身，不会退出本函数。
	//所以这里只在 catch 里记录错误，真正的返回判断放到 try catch 之后。
	try{
		//真实文件用系统当前时间；模拟数据仍用固定测试时间，保证结果可复现
		res = frename.preview(files, rules, isReal ? time() : TEST_TIME);
	}
	catch(e){
		errText = tostring(e);
	}

	if(errText){
		winform.lvPreview.clear();
		lastPreviewRows = {};
		setStatus(T("preview.failEngine", errText));
		return;
	}

	if(type(res) != "table"){
		winform.lvPreview.clear();
		lastPreviewRows = {};
		setStatus(T("preview.failEmpty"));
		return;
	}

	//批量刷新：先关掉列表重绘，再逐行插入，避免上千行每行都触发重排重绘。
	//WM_SETREDRAW = 0xB。用 try 包住：万一该 API 不可用就退化成普通刷新，不影响功能。
	try{
		::User32.SendMessageInt(winform.lvPreview.hwnd, 0xB, 0, 0);
	}
	catch(e){}

	winform.lvPreview.clear();

	//引擎只负责算文件名，目标完整路径由「源文件所在目录 + 目标文件名」拼出来
	var items = buildItems(res,isReal);

	//预检只在真实文件上有意义：模拟数据没有真实路径，用 io.exist 判断会误判
	if(isReal){
		..frename.precheck.check(items);
	}

	for(i=1;#items;1){
		var it = items[i];

		var statusText;
		if(it.status == "error") statusText = T("status.error");
		elseif(it.status == "warning") statusText = T("status.warning");
		elseif(it.status == "ok") statusText = T("status.ok");
		elseif(it.changed) statusText = T("status.changed");
		else statusText = T("status.unchanged");

		var reason = ..frename.precheck.reasonText(it);
		if(!#reason && it.error) reason = tostring(it.error);

		winform.lvPreview.addItem({
			text = { it.originalName; it.newName; statusText; reason; it.sourcePath; it.targetPath };
		});
	}

	//恢复重绘并强制刷新一次
	try{
		::User32.SendMessageInt(winform.lvPreview.hwnd, 0xB, 1, 0);
		winform.lvPreview.invalidate();
	}
	catch(e){}

	lastPreviewRows = items;

	//状态栏统计
	var head = T("stat.rules", #rules, countEnabled());

	if(isReal){
		var st = ..frename.precheck.statistics(items);
		head = head ++ T("stat.real", st.total, st.ok, st.unchanged, st.risky, st.error, st.warning);
	}
	else {
		var st2 = frename.statistics(res);
		head = head ++ T("stat.mock", st2.totalFiles, st2.changedFiles, st2.unchangedFiles, st2.errorFiles);
	}

	setStatus(head);
}

//延迟刷新预览（供文本输入框使用）。
//注意：本函数必须定义在 refreshPreview 之后 —— aardio 的局部变量作用域从声明处
//才开始，若写在前面，这里引用的 refreshPreview 会被当成全局变量（运行时为 null）。
var refreshPreviewLater = function(){
	previewSeq = previewSeq + 1;
	var seq = previewSeq;

	//先取消上一次还没触发的刷新，连续输入时只留最后一次
	if(previewTimer !== null){
		try{ winform.clearTimeout(previewTimer); }catch(e){}
		previewTimer = null;
	}

	var tid;
	try{
		tid = winform.setTimeout(
			function(){
				//期间又有新输入、或已经手动刷新过了，这次就作废
				if(seq != previewSeq) return;
				previewTimer = null;
				refreshPreview();
			},
			PREVIEW_DELAY
		);
	}
	catch(e){
		//不支持定时器就退化为立即刷新，保证功能可用
		previewTimer = null;
		refreshPreview();
		return;
	}

	previewTimer = tid;
}

//---------- 语言切换 ----------

//按当前语言重新铺一遍全部界面文案。
//切换语言后调用它：控件文本、列表列名、规则类型下拉、说明区，
//以及规则列表「说明」列（来自 frename.rules.description）与预览都会一起更新。
var applyLanguage = function(){
	winform.text = T("app.title");

	winform.lblRules.text = T("lbl.rules");
	winform.btnAdd.text = T("btn.add");
	winform.btnUp.text = T("btn.up");
	winform.btnDown.text = T("btn.down");
	winform.btnDelete.text = T("btn.delete");
	winform.chkEnabled.text = T("chk.enabled");
	winform.lblParams.text = T("lbl.params");
	winform.lblPreview.text = T("lbl.preview");
	winform.btnLoadFiles.text = T("btn.loadFiles");
	winform.btnLoadDir.text = T("btn.loadDir");
	winform.btnClearFiles.text = T("btn.clearFiles");
	winform.btnExecute.text = T("btn.execute");
	winform.btnUndo.text = T("btn.undo");

	//列表列名
	winform.lvRules.columns = {
		{T("col.rules.no"),34,2/*_LVCFMT_CENTER*/};
		{T("col.rules.type"),90,0/*_LVCFMT_LEFT*/};
		{T("col.rules.desc"),236,0/*_LVCFMT_LEFT*/};
		{T("col.rules.status"),80,2/*_LVCFMT_CENTER*/}
	};
	winform.lvPreview.columns = {
		{T("col.prev.orig"),110,0/*_LVCFMT_LEFT*/};
		{T("col.prev.target"),110,0/*_LVCFMT_LEFT*/};
		{T("col.prev.status"),60,2/*_LVCFMT_CENTER*/};
		{T("col.prev.note"),170,0/*_LVCFMT_LEFT*/};
		{T("col.prev.srcPath"),240,0/*_LVCFMT_LEFT*/};
		{T("col.prev.dstPath"),240,0/*_LVCFMT_LEFT*/}
	};

	//规则类型下拉
	var typeItems = {};
	for(i=1;#RULE_TYPES;1){
		..table.push(typeItems, T(RULE_TYPES[i].textKey));
	}
	winform.cmbRuleType.items = typeItems;
	if(!winform.cmbRuleType.selIndex) winform.cmbRuleType.selIndex = 1;

	//左下说明区：换行必须用单引号（编译时转义字符串），
	//双引号里的 \r\n 是 4 个字面字符，static 控件不会当成换行
	winform.lblHint.text = T("hint.title")
		++ '\r\n' ++ "1. " ++ T("hint.1")
		++ '\r\n' ++ "2. " ++ T("hint.2")
		++ '\r\n' ++ "3. " ++ T("hint.3")
		++ '\r\n' ++ "4. " ++ T("hint.4")
		++ '\r\n' ++ "5. " ++ T("hint.5")
		++ '\r\n' ++ "6. " ++ T("hint.6", string.join(MOCK_FILES,", "))
		++ '\r\n' ++ T("hint.6b", tostring(TEST_TIME,"%Y-%m-%d %H:%M:%S"));

	//说明列来自规则引擎、状态列与统计来自预检，都要重刷
	rebuildRuleList();
	showParams();
	refreshPreview();
}

//---------- 执行与撤销 ----------

//操作历史（纯内存）：保存 executePlan 的 executionResult 与 executionLog。
//变量名特意不叫 history，避免和 aardio 内置对象混淆。
var opHistory = frename.history.create();

//执行 / 撤销进行中标志：异步执行期间禁用两个按钮并忽略重复点击，避免并发改动文件
var isBusy = false;

//把一批「from -> to」步骤反映到 realFiles 上，让界面与磁盘保持一致。
//执行成功后按执行步骤正向同步；撤销后按逆向步骤同步。
var syncFilesBySteps = function(steps){
	if(type(steps) != "table") return;

	//一次建「路径键 -> 文件下标」索引，避免每一步都遍历整个文件表。
	//原来这里是「步骤 × 文件」双重循环，且最内层每次都重算两个 pathKey：
	//1500 个文件时约 900 万次 pathKey，是执行后界面同步最大的耗时点。
	var index = {};
	for(j=1;#realFiles;1){
		index[[ ..frename.filescan.pathKey(realFiles[j].path) ]] = j;
	}

	for(i=1;#steps;1){
		var e = steps[i];
		if(type(e) != "table") continue;

		var fromKey = ..frename.filescan.pathKey(e.from);
		var j = index[[fromKey]];
		if(!j) continue;	//这一步的文件不在当前列表里

		var f = realFiles[j];
		var info = ..io.splitpath(e.to);
		f.path = e.to;
		f.name = info.file;
		f.dir = info.dir;

		//同步维护索引：两阶段执行时同一个文件会连续出现两步
		//（原名→临时名→目标名），第二步的 from 就是第一步的 to，
		//索引不更新就找不到了
		index[[fromKey]] = null;
		index[[ ..frename.filescan.pathKey(e.to) ]] = j;
	}

	//重建去重键：撤销后路径变了，旧键会把同一个文件误判成重复
	fileKeys = {};
	for(i=1;#realFiles;1){
		fileKeys[[ ..frename.filescan.pathKey(realFiles[i].path) ]] = true;
	}
}

//执行重命名。
//流程固定为：validate.check -> 用户确认 -> executor.executePlan -> history.addSession，
//任何一步不通过都不会真的动文件。
var executeRename = function(){
	//异步执行期间禁止重复点击，也禁用撤销按钮，避免并发改动文件
	if(isBusy) return;
	isBusy = true;
	winform.btnExecute.enabled = false;
	winform.btnUndo.enabled = false;

	//所有提前退出都只离开 doExecute，外层的 isBusy / 按钮复位一定会被执行
	var doExecute = function(){
		//1. 必须先加载真实文件（模拟数据没有真实路径，不能执行）
		if(!#realFiles){
			setStatus(T("exec.needFiles"));
			winform.msgbox(T("exec.needFilesBox"), T("dlg.cannotExecute"), 0);
			return;
		}

		//2. 用当前规则算出目标名称，生成两阶段计划
		var fs = frename.fileadapter.createWindowsFs();
		var res;
		try{
			res = frename.preview(buildPreviewFiles(), rules, time());
		}
		catch(e){
			setStatus(T("preview.failEngine", tostring(e)));
			return;
		}

		var plan = frename.renameplan.build(buildItems(res,true), fs.existsFunc);

		//3. 校验（不允许绕过）
		var vr = frename.validate.check(plan, fs.existsFunc);

		if(!vr.ok){
			var msg = T("exec.validateHead");
			for(i=1;#vr.errors;1){
				msg = msg ++ "· " ++ tostring(vr.errors[i].reason) ++ '\r\n';
			}
			winform.msgbox(msg, T("dlg.validationFailed"), 0);
			setStatus(T("exec.validateStatus", #vr.errors));
			return;
		}

		//4. 用户确认
		var confirmMsg = T("exec.confirm", #plan.operations);
		if(#vr.warnings) confirmMsg = confirmMsg ++ T("exec.confirmWarn", #vr.warnings);
		if(#plan.blocked) confirmMsg = confirmMsg ++ T("exec.confirmBlocked", #plan.blocked);
		confirmMsg = confirmMsg ++ T("exec.confirmAsk");

		if(winform.msgbox(confirmMsg, T("dlg.confirmRename"), 1) != 1){
			setStatus(T("exec.cancelled"));
			return;
		}

		//5. 执行放进后台线程，UI 线程不卡（thread.invokeAndWait 等待时仍处理界面消息）。
		//   plan 是纯数据表，按 aardio 的线程间序列化传值；fs 在后线程里 import 创建，
		//   函数不走序列化。执行期间用户仍可拖动窗口、操作界面。
		setStatus(T("exec.running"));
		winform.lblStatus.update();

		var execRes, execErr;
		try{
			execRes = thread.invokeAndWait(
				function(plan){
					import frename.fileadapter;
					import frename.executor;
					var fs = frename.fileadapter.createWindowsFs();
					return frename.executor.executePlan(plan, fs);
				},
				plan
			);
		}
		catch(e){
			execErr = tostring(e);
		}

		if(execErr){
			setStatus(T("exec.errorStatus", execErr));
			winform.msgbox(T("exec.errorBox", execErr), T("dlg.execResult"), 0);
			return;
		}

		//6. 记入历史（UI 线程）
		var session = opHistory.addSession(execRes, T("hist.manualRename"));

		//7. 全部成功才把列表同步到新文件名
		if(execRes.success){
			syncFilesBySteps(execRes.executed);
		}

		refreshPreview();

		//8. 结果：成功数 / 失败数 / 是否可撤销
		var undoText = T("undo.notUndoable");
		if(session && session.undoable) undoText = T("undo.undoable");

		if(execRes.success){
			setStatus(T("exec.successStatus", #plan.operations, #plan.blocked, undoText));
			winform.msgbox(T("exec.successBox", #execRes.executed, #plan.blocked, undoText),
				T("dlg.execResult"), 0);
		}
		else {
			setStatus(T("exec.failStatus", execRes.message));
			winform.msgbox(T("exec.failBox", #execRes.executed, execRes.failedStep.reason,
				(execRes.rollbackOk ? T("bool.yes") : T("bool.no")), undoText),
				T("dlg.execResult"), 0);
		}
	};

	doExecute();

	isBusy = false;
	winform.btnExecute.enabled = true;
	winform.btnUndo.enabled = true;
}

//撤销上一次可撤销的操作。
//必须通过 history.getLastUndoable 取会话；撤销完成后调 markUndone。
var undoLast = function(){
	if(isBusy) return;
	isBusy = true;
	winform.btnExecute.enabled = false;
	winform.btnUndo.enabled = false;

	var doUndo = function(){
		var session = opHistory.getLastUndoable();

		if(!session){
			setStatus(T("undo.none"));
			winform.msgbox(T("undo.noneBox"), T("dlg.cannotUndo"), 0);
			return;
		}

		if(winform.msgbox(T("undo.confirm", session.message), T("dlg.confirmUndo"), 1) != 1){
			setStatus(T("undo.cancelled"));
			return;
		}

		//撤销也放进后台线程，UI 不卡
		setStatus(T("undo.running"));
		winform.lblStatus.update();

		var rb, rbErr;
		try{
			rb = thread.invokeAndWait(
				function(log){
					import frename.fileadapter;
					import frename.executor;
					var fs = frename.fileadapter.createWindowsFs();
					return frename.executor.rollback(log, fs);
				},
				session.executionLog
			);
		}
		catch(e){
			rbErr = tostring(e);
		}

		if(rbErr){
			setStatus(T("undo.errorStatus", rbErr));
			winform.msgbox(T("undo.errorBox", rbErr), T("dlg.undoResult"), 0);
			return;
		}

		if(!rb.ok){
			//部分失败：如实报告，并标记为已撤销，避免反复尝试同一批次
			opHistory.markUndone(session.id);
			refreshPreview();
			setStatus(T("undo.partialStatus", #rb.failed));
			winform.msgbox(T("undo.partialBox", #rb.failed), T("dlg.undoResult"), 0);
			return;
		}

		//撤销成功：标记 + 把文件列表同步回原名
		opHistory.markUndone(session.id);

		var undoSteps = {};
		for(i=#session.executionLog;i>=1;i--){
			var e = session.executionLog[i];
			table.push(undoSteps,{ from = e.to; to = e.from });
		}
		syncFilesBySteps(undoSteps);

		refreshPreview();

		setStatus(T("undo.okStatus", rb.doneCount));
		winform.msgbox(T("undo.okBox", rb.doneCount), T("dlg.undoResult"), 0);
	};

	doUndo();

	isBusy = false;
	winform.btnExecute.enabled = true;
	winform.btnUndo.enabled = true;
}

//---------- 操作 ----------

var addRule = function(){
	var si = winform.cmbRuleType.selIndex;
	if(!si) si = 1;

	var t = RULE_TYPES[si].value;
	table.push(rules, { type=t; enabled=true; params=defaultParams(t) });
	selRule = #rules;

	rebuildRuleList();
	showParams();
	refreshPreview();
	setStatus(T("rule.added", T(RULE_TYPES[si].textKey)));
}

var deleteRule = function(){
	if(!selRule){
		setStatus(T("rule.selectFirst"));
		return;
	}

	var text = typeText(rules[selRule].type);
	table.remove(rules, selRule);

	if(selRule > #rules) selRule = #rules;

	rebuildRuleList();
	showParams();
	refreshPreview();
	setStatus(T("rule.deleted", text));
}

var moveRule = function(delta){
	if(!selRule){
		setStatus(T("rule.selectFirst"));
		return;
	}

	var j = selRule + delta;
	if(j < 1 || j > #rules){
		setStatus(T("rule.atBoundary"));
		return;
	}

	var tmp = rules[selRule];
	rules[selRule] = rules[j];
	rules[j] = tmp;
	selRule = j;

	rebuildRuleList();
	showParams();
	refreshPreview();
	setStatus(T("rule.moved", selRule));
}

//---------- 事件绑定 ----------

winform.btnAdd.oncommand = function(id,event){
	addRule();
}

winform.btnDelete.oncommand = function(id,event){
	deleteRule();
}

winform.btnUp.oncommand = function(id,event){
	moveRule(-1);
}

winform.btnDown.oncommand = function(id,event){
	moveRule(1);
}

//---------- 真实文件加载 ----------
//严格限制：这里只读取用户选择的文件与文件夹元数据，
//不创建、修改、移动、删除或重命名任何文件，也没有「执行重命名」的入口。

//把一次扫描的结果并入列表，并把扫描范围、重复数、失败明细反馈给用户
var mergeScanResult = function(result,scopeText){
	var added = 0;
	for(i=1;#result.files;1){
		..table.push(realFiles,result.files[i]);
		added = added + 1;
	}

	refreshPreview();

	var msg = T("scan.summary", scopeText, added, #realFiles);
	if(result.dupCount) msg = msg ++ T("scan.dup", result.dupCount);

	//访问失败不能静默跳过：把失败项也列出来，写清路径与原因
	if(#result.errors){
		msg = msg ++ T("scan.failed", #result.errors);

		for(i=1;#result.errors;1){
			var e = result.errors[i];
			..table.push(lastPreviewRows,{
				originalName = "";
				newName = "";
				status = "error";
				reasons = { e.reason };
				sourcePath = e.path;
				targetPath = "";
			});
			winform.lvPreview.addItem({
				text = { T("lv.readFailed"); ""; T("status.error"); e.reason; e.path; "" };
			});
		}
	}

	setStatus(msg);
}

winform.btnLoadFiles.oncommand = function(id,event){
	//多选文件：返回路径数组，取消返回 null
	var paths = fsys.dlg.openMulti(T("files.filter"), T("files.pickTitle"));
	if(type(paths) != "table" || !#paths) return;

	mergeScanResult( frename.filescan.scan(paths,fileKeys), T("files.selectedFiles", #paths) );
}

winform.btnLoadDir.oncommand = function(id,event){
	//多选文件夹：返回路径数组，取消返回 null
	var dirs = fsys.dlg.dirs(,, T("dirs.pickTitle"));
	if(type(dirs) != "table" || !#dirs) return;

	//文件夹本身不作为待重命名文件，只取其直接子文件
	mergeScanResult( frename.filescan.scan(dirs,fileKeys),
		T("files.selectedDirs", #dirs) );
}

winform.btnClearFiles.oncommand = function(id,event){
	realFiles = {};
	fileKeys = {};
	refreshPreview();
	setStatus(T("files.cleared"));
}

winform.btnExecute.oncommand = function(id,event){
	executeRename();
}

winform.btnUndo.oncommand = function(id,event){
	undoLast();
}

//切换语言：改当前语言后重铺全部文案
winform.cmbLang.onSelChange = function(){
	var i = winform.cmbLang.selIndex;
	if(!i) return;

	var code = ..frename.i18n.LANGS[i];
	if(!..frename.i18n.setLang(code)) return;

	applyLanguage();
	setStatus(T("lbl.status.ready"));
}

//双击预览行：在状态栏显示该行完整路径，避免列宽不够看不全
winform.lvPreview.onDoubleClick = function(item,subItem,nm){
	var it = lastPreviewRows[item];
	if(type(it) != "table") return;
	setStatus(T("preview.dblclick", tostring(it.sourcePath), tostring(it.targetPath)));
}

winform.chkEnabled.oncommand = function(id,event){
	if(busy) return;

	var rule = rules[selRule];
	if(type(rule) != "table"){
		//选中状态和记录不一致时，先把界面同步回来再提示
		setStatus(T("rule.selectFirst"));
		return;
	}

	rule.enabled = winform.chkEnabled.checked ? true : false;

	//只改这一行的文字，不重建列表，避免抢走复选框的焦点
	updateRuleRow(selRule);
	refreshPreview();

	//启用状态变化要改整行灰度；文字没变时 setItemText 可能不触发重绘，
	//主动让列表重画，customdraw 会按 rules[i].enabled 重新着色
	winform.lvRules.invalidate();
	winform.lvRules.update();
}

//选中同步：同时挂 onItemChanged 与 onSelChanged 两个通知。
//两者都可能漏报（见文件顶部说明），但 syncSelectionFromList 是幂等的，
//真正以控件当前状态为准，所以重复触发不会出问题。
winform.lvRules.onItemChanged = function(item,subItem,nm){
	syncSelectionFromList();
}

winform.lvRules.onSelChanged = function(selected,item,subItem,nm){
	syncSelectionFromList();
}

//自定义绘制：禁用的规则整行灰度显示。
//列表已用「状态」列显示「启用 / 禁用」文字（见 rebuildRuleList），这里额外把禁用行变灰。
//颜色按 rules[i].enabled 实时评估，改勾选后由下一行 updateRow 触发的重绘自动刷新，
//不需要再单独维护每行的颜色状态。
winform.lvRules.onnotify = function(id,code,ptr){
	//只接管 NM_CUSTOMDRAW，其余通知（LVN_xxx 等）原样交给默认处理
	if(code != 0xFFFFFFF4/*_NM_CUSTOMDRAW*/) return;

	var lvcd = winform.lvRules.getNotifyCustomDraw(code, ptr);
	if(!lvcd) return;

	var stage = lvcd.nmcd.dwDrawStage;

	if(stage == 0x1/*_CDDS_PREPAINT*/){
		//订阅每一项的 pre-paint 通知
		return 0x20/*_CDRF_NOTIFYITEMDRAW*/;
	}

	if(stage == 0x10001/*_CDDS_ITEMPREPAINT*/){
		//listview 行号从 0 开始，rules 下标从 1 开始
		var i = lvcd.nmcd.dwItemSpec + 1;
		var rule = rules[i];
		var disabled = (type(rule) == "table" && !rule.enabled);

		//COLORREF 是 0xBBGGRR；灰度三通道相等，无字节序问题
		lvcd.clrText = disabled ? 0x808080 : 0x000000;
		lvcd.update();

		//用上面设置的颜色画文字
		return 0x20/*_CDRF_NEWFONT*/;
	}

	//其他阶段交给系统默认处理
	return 0/*_CDRF_DODEFAULT*/;
}

//把「常用正则」下拉选中的正则写入目标参数，并同步显示到目标输入框。
//只在下拉选中时调用一次；第 1 项「（自定义）」不写入，保留手填的正则。
var applyPreset = function(){
	var rule = rules[selRule];
	if(type(rule) != "table") return;

	var sc = visibleSchema(rule);
	var params = paramsOf(rule);

	for(i=1;PARAM_ROWS;1){
		var d = sc[i];
		if(type(d) != "table" || d.kind != "preset") continue;

		var pi = comboParams[i].selIndex;
		if(!pi || pi <= 1 || !d.target) continue;

		var v = d.patterns[pi];
		params[d.target] = v;

		//同步到目标输入框，否则界面上看不到刚选的正则
		for(j=1;PARAM_ROWS;1){
			if(type(sc[j]) == "table" && sc[j].key == d.target){
				busy = true;
				editParams[j].text = v;
				busy = false;
			}
		}
	}
}

//手改了某个输入框之后：如果它是「常用正则」的目标，就把常用正则拉回「（自定义）」。
//否则下拉仍停在某个预设项上，下一次参数收集就会用那个预设覆盖掉刚手填的内容。
var resetPresetOf = function(row){
	var rule = rules[selRule];
	if(type(rule) != "table") return;

	var sc = visibleSchema(rule);
	var def = sc[row];
	if(type(def) != "table") return;

	for(k=1;PARAM_ROWS;1){
		var d = sc[k];
		if(type(d) == "table" && d.kind == "preset" && d.target == def.key){
			busy = true;
			comboParams[k].selIndex = 1;
			busy = false;
		}
	}
}

//参数变化：把面板写回规则后，只更新当前行文字和预览（不重建列表，避免打断输入）
//
//row 是触发变化的控件所在行，isCombo 表示来自下拉框还是文本输入框。
//下拉框：可能改变「条件显示」的行，也可能刚选了常用正则，需要重排参数面板；
//文本框：每次按键都触发，重排会把光标顶到末尾、打断连续输入，所以不重排，
//        只在它恰好是常用正则的目标时，把常用正则拉回「（自定义）」。
var onParamChanged = function(row,isCombo){
	if(busy) return;

	collectParams();

	if(isCombo){
		applyPreset();

		var sc = schemaOf(rules[selRule]);
		var needRebuild = false;

		for(k=1;PARAM_ROWS;1){
			var d = sc[k];
			if(type(d) == "table" && (type(d.showIf) == "table" || d.kind == "preset")) needRebuild = true;
		}

		if(needRebuild) showParams();
	}
	elseif(row){
		resetPresetOf(row);
	}

	updateRuleRow(selRule);

	//下拉框是一次性选择，立即刷新；
	//文本框每敲一个字符都触发，延迟刷新，避免连续输入时反复重算整份预览
	if(isCombo) refreshPreview();
	else refreshPreviewLater();
}

//用函数包一层再绑定：参数 row 每次调用都是独立的，
//避免直接在 for 里写闭包时捕获到同一个循环变量
var bindCombo = function(row,ctrl){
	ctrl.onSelChange = function(){
		onParamChanged(row,true);
	}
}

var bindEdit = function(row,ctrl){
	ctrl.onChange = function(){
		onParamChanged(row,false);
	}
}

for(i=1;PARAM_ROWS;1){
	bindEdit(i, editParams[i]);
	bindCombo(i, comboParams[i]);
}

//---------- 初始化 ----------

//语言下拉：直接显示语言代码（en / zh），选中当前语言
var langItems = {};
for(i=1;#..frename.i18n.LANGS;1){
	..table.push(langItems, ..frename.i18n.LANGS[i]);
}
winform.cmbLang.items = langItems;
for(i=1;#..frename.i18n.LANGS;1){
	if(..frename.i18n.LANGS[i] == ..frename.i18n.getLang()) winform.cmbLang.selIndex = i;
}
if(!winform.cmbLang.selIndex) winform.cmbLang.selIndex = 1;

//按当前语言铺一遍全部界面文案
//（含控件文本、列表列名、规则类型下拉、说明区，并重建规则列表与预览）
applyLanguage();

//窗口缩放时重排；onSize 即 adjust 事件，参数是客户区宽高
winform.onSize = function(cx,cy,wParam){
	applyLayout(cx,cy);
}

//按当前客户区先排一次
applyLayout();

//限制窗口最小尺寸，避免缩得过小把控件压重叠
win.ui.minmax(winform,MIN_CLIENT_W,MIN_CLIENT_H);

//返回窗体对象，main.aardio 中的 win.loadForm 会接收此返回值
return winform;
